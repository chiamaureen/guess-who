{
  "name": "guess-who",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run && node --test scripts/check-supabase.node-test.mjs && npm run test:db && npm run test:rooms && npm run test:game && node --test scripts/question-bank.node-test.mjs scripts/question-images.node-test.mjs && npm run check:edge",
    "test:db": "node --test supabase/tests/database.node-test.mjs",
    "check:supabase": "node scripts/check-supabase.mjs",
    "check:db": "node scripts/check-database-schema.mjs --linked",
    "test:rooms": "node --test supabase/tests/room-system.node-test.mjs",
    "test:game": "node --test supabase/tests/game-engine.node-test.mjs",
    "check:edge": "tsc -p tsconfig.edge.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "gsap": "^3.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "sharp": "0.35.5",
    "supabase": "2.121.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  }
}
